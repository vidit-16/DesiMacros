# Groq API key — free at https://console.groq.com/keys
# Powers meal parsing and the weekly coach summary.
GROQ_API_KEY=your_groq_api_key_here

# USDA FoodData Central key — free at https://fdc.nal.usda.gov/api-key-signup
# Optional: used as a fallback when a food isn't in the local IFCT table.
USDA_API_KEY=your_usda_api_key_here

APP_ENV=development
DATABASE_URL=sqlite:///./data/desimacros.db

# Base URL the Streamlit UI uses to reach the FastAPI backend.
# Same container / bare metal: http://localhost:8000
# docker-compose: http://api:8000
API_BASE_URL=http://localhost:8000
